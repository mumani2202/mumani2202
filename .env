##### Buy Amount in SOL #####
AMOUNT=0.1

##### Slippage #####
SLIPPAGE=50

##### Front Running Protection true or false#####
#####PROTECTION=false

##### Bloxroute TIP for buys #####
#####BUY_TIP=0.001
##### Bloxroute TIP for sells #####
#####SELL_TIP=0.001

##### Take profit % #####
