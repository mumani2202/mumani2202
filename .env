##### Check metadata urls true for yes false for no #####
CHECK_URLS=true

##### Tag of the tokens that you want to buy - leave empty if no need #####
SNIPE_BY_TAG=AI

##### MAX Positions at a time Minimum 1 or maximum any you want #####
MAX_POSITIONS=2
